# Supabase project for the marketplace (separate from any other project).
# Both are safe to expose to the browser — every table/bucket they touch is
# protected by Row Level Security. Never add a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Everything below is SERVER-ONLY. Never prefix with NEXT_PUBLIC_. ----

# Supabase secret key (sb_secret_...). Bypasses RLS — used only inside
# Next.js route handlers (lib/supabase/admin.ts) to read the real document
# price and to generate short-lived signed URLs for paid documents after a
# verified payment. This is the modern replacement for the legacy
# service_role JWT (Supabase Dashboard -> Settings -> API Keys ->
# Publishable and secret API keys tab).
SUPABASE_SECRET_KEY=

# Sifalo Pay credentials (Merchant -> API in the Sifalo portal).
# Staging keys only work with the .net hosts below; live keys only with
# the .com hosts. See https://developer.sifalopay.com/docs/create-api-keys
SIFALO_API_USER=
SIFALO_API_KEY=

# Staging: https://spay-api.sifalo.net/gateway/
# Live:    https://api.sifalopay.com/gateway/
SIFALO_GATEWAY_URL=

# Staging: https://pay.sifalo.net/checkout/
# Live:    https://pay.sifalo.com/checkout/
SIFALO_CHECKOUT_URL=
